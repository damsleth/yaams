<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.yaams.ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/USER/.local/bin/yaams</string>
    <string>ingest</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USER/yaams-repo</string>

  <!-- Run nightly at 02:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/USER/Library/Logs/yaams/ingest.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/yaams/ingest.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/USER</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
